# Copy to `.env` and fill in, or export these vars some other way.
# The app reads them from process.env. For a 1Password-based local workflow,
# see scripts/dev.local.sh.example.

# Required: Vercel AI Gateway API key
# AI_GATEWAY_API_KEY=vck_...

# Optional: Tavily API key (enables the web_search tool when set)
# TAVILY_API_KEY=tvly-...

# MCP server paths (auto-detected from sibling dirs if omitted)
# KEYBOARDS_MCP_PATH=../keyboards-mcp/dist/index.js
# AUDIO_ANALYSIS_MCP_PATH=../audio-analysis-mcp/.venv/bin/python

# Optional
# AGENT_PORT=3001
# LLM_MODEL=anthropic/claude-sonnet-4-20250514
# MAX_HISTORY_MESSAGES=40
